# MongoDB Atlas connection string (Connect -> Drivers -> Node.js).
# Replace <db_password> with the database user's password, URL-encoded.
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name the app writes to. Optional; defaults to "challenger".
MONGODB_DB="challenger"

# Login passwords, checked server-side only.
CHALLENGER_PASSWORD="thechallenger"
GM_PASSWORD="generalmanagerpepi"
